{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es6",
    "noImplicitAny": true,
    "sourceMap": true,
    "inlineSources": true,
    "outDir": "dist",
    "declaration": true,
    "declarationDir": "dist/types",
    "strict": false,
    "types": [
      "node",
      "mocha"
    ]
  },
  "include": [
    "src/**/*",
    "test/**/*.test.ts"
  ]
}
